<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Does the app or any SDK track users across apps/websites? -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- Domains used for tracking (none) -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- Data types collected from users (none — all data stays on device) -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- Required-reason APIs used by the app -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- UserDefaults — used by @AppStorage("hasSeenOnboarding") -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- CA92.1: Read/write info accessible only to the app itself -->
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
